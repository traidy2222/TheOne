        c.thermal.y += extraHeat;
        float t = temperature(c);
        c.thermal.w = flameFront(i, c);
        float burn = (t >= vol.fuel.w || c.thermal.w <= 0)
                         ? min(c.species.x * (1 - exp(-vol.optics.w * step.dt)), c.species.y / vol.fuel.y)
                         : 0;
        c.species.x -= burn;
        c.species.y -= burn * vol.fuel.y;
        c.species.z += burn * vol.fuel.z;
        c.species.w += burn * (1 + vol.fuel.y - vol.fuel.z);
        float released = burn * vol.fuel.x;
        c.thermal.y += released;
        t = temperature(c);
        float excess = max(0, c.thermal.y - density(c) * vol.gas.z * vol.gas.x);
        float cooling = excess * (1 - exp(-vol.gas.w * step.dt));
        float radiative = 4 * c.species.z * vol.optics.x * 5.670374419e-8 *
                          max(0, pow(min(t, 6000.), 4) - pow(vol.gas.x, 4)) * step.dt;
        float lost = min(excess, cooling + radiative);
        c.thermal.y -= lost;
        c.thermal.z = vol.windClosed.w > .5 ? 0 : (released + extraHeat - lost) / (oldH * step.dt);
        float dv = h.x * h.y * h.z;
        ledgers[id].budget += vec4(burn, lost / step.dt, (dot(boundarySpecies, vec4(1)) + boundaryThermal.x),
                                   boundaryThermal.y) *
                              vec4(dv, step.dt * dv, step.dt * dv, step.dt * dv);
        ledgers[id].species += boundarySpecies * step.dt * dv;
        storeCell(i, writeState, c);
        return;
    }
    if (operation == 3) {
        vec3 vort =
            (vol.initial.z > 0 && (c.species.z > 1e-7 || c.species.x > 1e-6)) ? confinement(i) : vec3(0);
        for (int a = 0; a < 3; ++a) {
            ivec3 j = i;
            j[a]++;
            VolumeCell next = stateCell(j, step.readState);
            float t = .5 * (temperature(c) + temperature(next));
            float buoyancy = (t - vol.gas.x) / vol.gas.x;
            c.velocity[a] += (-vol.gravityMax[a] * buoyancy + vort[a]) * step.dt;
            c.velocity[a] += (vol.windClosed[a] - c.velocity[a]) * (1 - exp(-.08 * step.dt));
            for (uint s = 0; s < vol.counts.x; ++s) {
                float sourceDt =
                    max(0., min(step.time + step.dt, vol.sourceInterval[s].x + vol.sourceInterval[s].y) -
                                max(step.time, vol.sourceInterval[s].x));
                vec3 q = (p - vol.sourcePosition[s].xyz) / vol.sourcePosition[s].w;
                float w = max(0, 1 - dot(q, q));
                vec3 jet = vol.sourceVelocity[s].xyz;
                float injected = (vol.sourceRates[s].x + vol.sourceRates[s].y) * w * w /
                                 max(1e-10, vol.sourceRates[s].w) * sourceDt;
                c.velocity[a] += (jet[a] - c.velocity[a]) * injected / max(.0001, density(c) + injected);
            }
            if (abs(c.velocity[a]) > vol.gravityMax.w)
                atomicAdd(diagnostics[12], 1);
            c.velocity[a] = clamp(c.velocity[a], -vol.gravityMax.w, vol.gravityMax.w);
            if (blockedFace(i, a)) {
                vec3 q = p;
                q[a] += h[a] * .5;
                c.velocity[a] = boundaryVelocity(q)[a];
            }
        }
        storeCell(i, writeState, c);
        return;
    }
    if (operation == 4) {
        rhs[id] = solidCell(i) ? 0 : (divergenceAt(i) - c.thermal.z) / step.dt;
        pressureA[id] = pressureB[id] = 0;
        if (reusePressureStencil) {
            vec3 negative = vec3(0), positive = vec3(0);
            float diagonal = 0;
            if (!solidCell(i))
                for (int a = 0; a < 3; ++a)
                    for (int sign = -1; sign <= 1; sign += 2) {
                        ivec3 face = i;
                        if (sign < 0)
                            face[a]--;
                        float coefficient =
                            blockedFace(face, a) ? 0 : faceInverseDensity(face, a) / (h[a] * h[a]);
                        if (sign < 0)
                            negative[a] = coefficient;
                        else
                            positive[a] = coefficient;
                        diagonal += coefficient;
                    }
            // The illumination cache is scratch until lighting runs. Reuse its
            // two vec4s per cell; no new allocation or descriptor is required.
            uint n = uint(dimensions().x * dimensions().y * dimensions().z);
            volumeLight[id] = vec4(negative, diagonal);
            volumeLight[id + n] = vec4(positive, 0);
        }
        atomicMax(diagnostics[13], floatBitsToUint(abs(rhs[id] * step.dt)));
        return;
    }
    if (operation == 5) {
        if (reusePressureStencil) {
            uint n = uint(dimensions().x * dimensions().y * dimensions().z);
            vec4 negative = volumeLight[id], positive = volumeLight[id + n];
            float numerator = 0;
            for (int a = 0; a < 3; ++a) {
                ivec3 low = i, high = i;
                low[a]--;
                high[a]++;
                numerator += negative[a] * pressureAt(low);
                numerator += positive[a] * pressureAt(high);
            }
            float pressure = negative.w > 0 ? (numerator - rhs[id]) / negative.w : 0;
            if (step.pressureRead == 0)
                pressureB[id] = pressure;
            else
                pressureA[id] = pressure;
            return;
        }
        float numerator = 0, denominator = 0;
        for (int a = 0; a < 3; ++a)
            for (int sign = -1; sign <= 1; sign += 2) {
                ivec3 j = i;
                j[a] += sign;
                ivec3 face = sign > 0 ? i : j;
                if (blockedFace(face, a))
                    continue;
                float coefficient = faceInverseDensity(face, a) / (h[a] * h[a]);
                numerator += coefficient * pressureAt(j);
                denominator += coefficient;
            }
        float pressure = denominator > 0 && !solidCell(i) ? (numerator - rhs[id]) / denominator : 0;
        if (step.pressureRead == 0)
            pressureB[id] = pressure;
        else
            pressureA[id] = pressure;
        return;
    }
    if (operation == 6) {
        for (int a = 0; a < 3; ++a) {
            ivec3 j = i;
            j[a]++;
            if (blockedFace(i, a)) {
                vec3 q = p;
                q[a] += h[a] * .5;
                c.velocity[a] = boundaryVelocity(q)[a];
            } else
                c.velocity[a] -= step.dt * faceInverseDensity(i, a) * (pressureAt(j) - pressureAt(i)) / h[a];
            if (abs(c.velocity[a]) > vol.gravityMax.w)
                atomicAdd(diagnostics[12], 1);
            c.velocity[a] = clamp(c.velocity[a], -vol.gravityMax.w, vol.gravityMax.w);
        }
        storeCell(i, writeState, c);
        return;
    }
}
