string(RANDOM LENGTH 12 TOKEN)
set(OUTPUT "${DEST}/converted-${TOKEN}.glb")
execute_process(COMMAND "${IMPORTER}" "${SOURCE}" "${OUTPUT}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE LOG ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "Conversion failed: ${ERROR}\n${LOG}")
endif()
execute_process(COMMAND "${INSPECTOR}" "${OUTPUT}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE REPORT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "Converted GLB rejected: ${ERROR}")
endif()
string(JSON IMAGES GET "${REPORT}" images)
string(JSON TRIANGLES GET "${REPORT}" triangles)
if(IMAGES LESS 1 OR TRIANGLES LESS 12)
  message(FATAL_ERROR "Conversion lost texture or geometry: ${REPORT}")
endif()
file(REMOVE "${OUTPUT}" "${OUTPUT}.report.json")
message(STATUS "OBJ + MTL + PNG converted to self-contained GLB and validated by runtime")
